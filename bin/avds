#!/bin/sh
set -eu
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PYTHON_BIN=${AVDS_PYTHON:-python3}
if [ -x "$PROJECT_DIR/.venv/bin/python" ]; then PYTHON_BIN="$PROJECT_DIR/.venv/bin/python"; fi
PYTHONPATH="$PROJECT_DIR/src${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON_BIN" -m avds.cli "$@"
